# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요. (.env 는 GitHub에 올라가지 않습니다)
#   cp .env.example .env

# AQuA 모의투자 서버
AQUA_BASE_URL=http://서버주소
AQUA_TEAM_CODE=TEAM-XXXXXXXX

# 1 이면 주문을 실제로 보내지 않고 로그만 남김. Google Cloud VM 의 .env 에서만 0 으로 바꿀 것
DRY_RUN=1

# Gemini (Google AI Studio에서 발급, 교육용 결제 계정 연결)
GEMINI_API_KEY=

# 뉴스 API (NLP·LLM 담당이 선정 후 채움)
NEWS_API_KEY=
NEWS_API_SECRET=

# (선택) 장애 알림용 디스코드 웹훅
DISCORD_WEBHOOK_URL=
